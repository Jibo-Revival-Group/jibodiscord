DISCORD_TOKEN=your_discord_bot_token_here
# Only stay in this Discord server (snowflake ID). The bot leaves any other guild.
DISCORD_GUILD_ID=your_discord_server_id_here
# Path to your OpenJibo checkout (used for legacy .mim response data and API keys)
OPENJIBO_PATH=/home/zane/JiboExperiments/OpenJibo
# Optional: fetch fun facts from uselessfacts.jsph.pl (falls back to catalog)
USE_FUN_FACT_API=true

# Optional: /ai and !ai (OpenAI Responses API + Discord history vector store)
# OPENAI_API_KEY=
# OPENAI_AI_MODEL=gpt-4.1-mini
# OPENAI_VECTOR_STORE_ID=vs_6a5a46ef89408191bb8ce3cf2a6f132d

# Optional overrides — when unset, keys and URLs are read from OpenJibo appsettings.json:
# OPENWEATHER_API_KEY=
# OPENWEATHER_DEFAULT_LOCATION=Boston,US
# OPENWEATHER_USE_CELSIUS=false
# NEWSAPI_KEY=
# OPENJIBO_SEARCH_BACKEND=none
# OPENJIBO_SEARCH_FALLBACK=
# OPENJIBO_SEARCH_INSTRUCTIONS=
